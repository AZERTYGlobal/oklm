          "xml": "<key id=\"super-2\" output=\"²\" longPressKeyIds=\"sub-2\" />"
        },
        {
          "construct": "transform",
          "reason": "a second marker in `from` (chained dead keys)",
          "xml": "<transform from=\"\\m{greek}\\m{greek}\" to=\"\\u{B5}\" />"
        },
        {
          "construct": "transform",
          "reason": "a second marker in `from` (chained dead keys)",
          "xml": "<transform from=\"\\m{currency}\\m{currency}\" to=\"¤\" />"
        },
        {
          "construct": "transform",
          "reason": "regular-expression construct '('",
          "xml": "<transform from=\"\\m{.}(.)\" to=\"$1\" />"
        },
        {
          "construct": "transform",
          "reason": "a transform without `to` deletes its match",
          "xml": "<transform from=\"\\m{euro}\\m{euro}\" />"
        },
        {
          "construct": "display",
          "reason": "not readable (escape \\u is not part of the LDML output syntax)",
          "xml": "<display output=\"\\u0300\" display=\"${grave}\" />"
